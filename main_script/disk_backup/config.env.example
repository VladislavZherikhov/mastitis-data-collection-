# ============================================================
# Единый конфиг системы  (резервная копия в disk_backup/)
# Основной шаблон лежит в корне проекта: .env.example
# ============================================================

# --- Временные окна работы ---
WINDOW_1=06:00-08:00
WINDOW_2=18:00-20:00

# --- Диск для очистки (backup.py) ---
# Рабочий диск на Raspberry Pi: /mnt/hdd
DISK_MOUNT_POINT=/mnt/hdd
MEDIA_DIRS=photos,videos
DISK_USAGE_THRESHOLD=80
DISK_USAGE_TARGET=70
MIN_FILE_AGE_DAYS=1
LOG_FILE=logs/backup.log

# --- Съёмка (main.py) ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=mastitis-bucket
S3_PREFIX=test-grab

S3_KEY_ID=ВАШ_KEY_ID
S3_SECRET=ВАШ_SECRET

IP_CAM_RTSP_URL=rtsp://admin:no@192.168.0.6:554/user=admin&password=no&channel=1&stream=0.sdp
THERMAL_DEVICE=/dev/video0
THERMAL_WIDTH=256
THERMAL_HEIGHT=192

INTERVAL_SEC=10
SHOTS_PER_WINDOW=0

# --- Логи ---
LOG_DIR=logs
LOG_S3_PREFIX=logs
