# ============================================================
# Единый конфиг системы
# Скопируйте в .env и отредактируйте под своё железо.
# ============================================================

# --- Диск для очистки (backup.py) ---
DISK_MOUNT_POINT=/mnt/disk
MEDIA_DIRS=photos,videos
DISK_USAGE_THRESHOLD=80
DISK_USAGE_TARGET=70
MIN_FILE_AGE_DAYS=1
LOG_FILE=./logs/backup.log

# Альтернатива: пороги в свободном месте (байты, KB, MB, GB, TB)
# DISK_FREE_THRESHOLD=100GB
# DISK_FREE_TARGET=120GB

# --- Съёмка (main_script) ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=mastitis-bucket
S3_PREFIX=test-grab

S3_KEY_ID=ВАШ_KEY_ID
S3_SECRET=ВАШ_SECRET

IP_CAM_RTSP_URL=rtsp://admin:no@192.168.0.6:554/user=admin&password=no&channel=1&stream=0.sdp
THERMAL_DEVICE=/dev/video0

SHOTS=5
INTERVAL_SEC=3
