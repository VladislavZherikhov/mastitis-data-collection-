S3_KEY_ID=
S3_SECRET=
S3_BUCKET=
S3_PREFIX=
IP_CAM_RTSP_URL=
THERMAL_DEVICE=
INTERVAL_SEC=10
# окна работы ЧЧ:ММ-ЧЧ:ММ, нумерация WINDOW_1, WINDOW_2, ... (можно сколько угодно, через полночь тоже можно: 22:00-02:00)
WINDOW_1=06:00-08:00
WINDOW_2=18:00-20:00
# папка логов в бакете (логи лежат в <LOG_S3_PREFIX>/<имя_хоста>/<дата>.log)
LOG_S3_PREFIX=logs
# локальный диск для копий пакетов (пусто - не сохранять); подробности в drive_doc.md
DRIVE_MOUNT=/mnt/hdd
DRIVE_USAGE_THRESHOLD=80
DRIVE_USAGE_TARGET=70
DRIVE_MIN_AGE_DAYS=1
DRIVE_MIN_FREE=1GB
