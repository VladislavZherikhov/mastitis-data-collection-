S3_KEY_ID=
S3_SECRET=
S3_BUCKET=
S3_PREFIX=
IP_CAM_RTSP_URL=
THERMAL_DEVICE=
INTERVAL_SEC=10
# окна работы ЧЧ:ММ-ЧЧ:ММ, нумерация WINDOW_1, WINDOW_2, ... (можно сколько угодно, через полночь тоже можно: 22:00-02:00)
