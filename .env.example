S3_KEY_ID=
S3_SECRET=
S3_BUCKET=
S3_PREFIX=
IP_CAM_RTSP_URL=
THERMAL_DEVICE=
INTERVAL_SEC=10
# окна работы ЧЧ:ММ-ЧЧ:ММ, нумерация WINDOW_1, WINDOW_2, ... (можно сколько угодно, через полночь тоже можно: 22:00-02:00)
WINDOW_1=06:00-08:00
WINDOW_2=18:00-20:00
# логи в бакете: <LOG_S3_PREFIX>/<имя_хоста>/<дата>/<ЧЧ-ММ-СС>.log + status.json; подробности в documentation/logging.md
LOG_S3_PREFIX=logs
LOG_UPLOAD_INTERVAL_SEC=300
LOG_LEVEL=INFO
# локальный диск для копий пакетов (пусто - не сохранять); подробности в documentation/drive.md
DRIVE_MOUNT=/mnt/hdd
DRIVE_USAGE_THRESHOLD=80
DRIVE_USAGE_TARGET=70
DRIVE_MIN_AGE_DAYS=1
DRIVE_MIN_FREE=1GB
# защита от сбоев, подробности в documentation/cornercases.md
MAX_PENDING_UPLOADS=6
WATCHDOG_TIMEOUT_SEC=600
CLOCK_SYNC_WAIT_SEC=300
